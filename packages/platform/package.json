{
  "name": "@coredevkit/platform",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "devkit": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "format": "prettier --write src test package.json tsconfig.json tsconfig.build.json"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
